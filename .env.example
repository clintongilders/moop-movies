TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token

APP_ORIGIN=http://localhost:3000
# Use a long random secret; never prefix server secrets with VITE_.
SESSION_SECRET=replace_with_a_random_secret_at_least_32_bytes

# Upstash: Connect > TCP URL. Required for production. Never commit a real URL.
REDIS_URL=
# Render is behind one reverse proxy. Leave unset locally.
TRUST_PROXY_HOPS=

# ISO country code for provider availability.
WATCH_REGION=CA
